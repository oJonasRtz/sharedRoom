@rendermode InteractiveServer
@page "/create"
@inject Auth AuthService

<PageTitle>Create</PageTitle>

<main>

	<form class="form-container" @onsubmit="HandleSubmit">

		<div class="form-header">
			<h2>Create a new Room</h2>
		</div>

		<div class="form-sections">

			<section id="left-panel" class="panel">

				<section
					id="thumbnail-upload"
					class="thumbnail-frame"
				>

					@if (!string.IsNullOrWhiteSpace(thumbnailPreviewUrl))
					{
						<img src="@thumbnailPreviewUrl" alt="Thumbnail" class="thumbnail-preview" />
					}
					else
					{
						<div class="thumbnail-placeholder">
							<span>Thumbnail</span>
						</div>
					}

					<label class="add-button">
						<InputFile
							id="thumbnailInput"
							OnChange="OnFileSelected"
							accept=".png,.jpg,.jpeg"
							class="thumbnail-input"
						/>
						<span>@(string.IsNullOrWhiteSpace(thumbnailPreviewUrl) ? "+" : "Change Image")</span>
					</label>

				</section>

				<section
					id="room-name"
					class="input-group"
				>

					<input
						type="text"
						class="text-input"
						placeholder=" "
						id="roomName"
					/>

					<label
						class="floating-label"
						for="roomName"
					>
						Room Name
					</label>

				</section>

			</section>

			<section id="right-panel" class="panel @(isPrivate ? "private" : "")">

				<section class="visibility-wrapper">

					<section class="visibility-options">
						<h4>Visibility</h4>

						<label class="radio-option">

							<input
								id="visibilityPublic"
								type="radio"
								name="visibility"
								value="public"
								checked="@(!isPrivate)"
								@onclick='() => selectedVisibility = "public"'
							/>

							Public

						</label>

						<label class="radio-option">

							<input
								id="visibilityPrivate"
								type="radio"
								name="visibility"
								value="private"
								checked="@isPrivate"
								@onclick='() => selectedVisibility = "private"'
							/>

							Private

						</label>

					</section>

				</section>

				@if (isPrivate)
				{
					<section class="private-fields">

						<section class="input-group">

							<input
								type="text"
								class="text-input"
								placeholder=" "
								id="inviteCode"
							/>

							<label
								class="floating-label"
								for="inviteCode"
							>
								Invite Code
							</label>

						</section>

					</section>
				}

				<section class="description-wrapper">

					<section class="input-group">

						<textarea
							id="description"
							class="description-input"
							placeholder=" "
						></textarea>

						<label
							class="floating-label"
							for="description"
						>
							Description
						</label>

					</section>

				</section>

				<button
					type="submit"
					class="create-button"
				>
					Create Room
				</button>

			</section>

		</div>

	</form>

</main>

@code {

	private IBrowserFile? selectedFile;
	private string? thumbnailPreviewUrl;

	private string selectedVisibility = "public";

	private bool isPrivate => selectedVisibility == "private";

	protected override async Task OnInitializedAsync(){
		var token = await AuthService.EnsureAuth();
		Console.WriteLine($"Token: {token}");
	}

	private async Task OnFileSelected(InputFileChangeEventArgs e)
	{
		selectedFile = e.File;

		if (selectedFile is null)
		{
			thumbnailPreviewUrl = null;
			return;
		}

		await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
		using var memoryStream = new MemoryStream();
		await stream.CopyToAsync(memoryStream);

		var base64 = Convert.ToBase64String(memoryStream.ToArray());
		thumbnailPreviewUrl = $"data:{selectedFile.ContentType};base64,{base64}";

		Console.WriteLine(
			$"Selected file: {selectedFile.Name}"
		);
	}

	private Task HandleSubmit()
	{
		Console.WriteLine("Form submitted");

		return Task.CompletedTask;
	}
}
